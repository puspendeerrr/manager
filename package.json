{
  "name": "sonam-ai-work-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Sonam - AI Work Manager (Phase 1 MVP)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm install && npm run build --workspace=shared",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "prisma:db-push": "npm run prisma:db-push --workspace=server",
    "prisma:seed": "npm run prisma:seed --workspace=server",
    "cron:reminders": "npm run cron:reminders --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^7.0.2"
  }
}
