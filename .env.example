# ===================================================
# SONAM PRODUCTION & LOCAL ENVIRONMENT VARIABLES
# ===================================================

# ---------------------------------------------------
# Backend Web Service (Render / Node.js)
# ---------------------------------------------------
PORT=5000
NODE_ENV=production
FRONTEND_URL="https://sonam.puspender.in"
CLIENT_ORIGIN="https://sonam.puspender.in"
CORS_ORIGINS="https://sonam.puspender.in,http://localhost:5173"
DEFAULT_USER_ID="user_dev_01"

# ---------------------------------------------------
# Database Connection (PostgreSQL - Render / Neon / Supabase)
# ---------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/sonam_db?sslmode=require"

# ---------------------------------------------------
# OpenAI API (Optional for AI Natural Language Parsing)
# ---------------------------------------------------
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# ---------------------------------------------------
# Web Push VAPID Configuration (For Web Push Reminders)
# Generate via: npx web-push generate-vapid-keys
# ---------------------------------------------------
VAPID_PUBLIC_KEY="BEl62i95..."
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:admin@sonam.puspender.in"

# ---------------------------------------------------
# Frontend Environment Variables (Vercel)
# ---------------------------------------------------
# Set VITE_API_URL in Vercel project environment variables:
# VITE_API_URL=https://sonam-api.onrender.com/api
