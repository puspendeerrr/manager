  description           String
  impactScore           Float        @default(50.0)
  evidence              Json
  suggestedIntervention String
  detectedAt            DateTime     @default(now())
  resolvedAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([severity])
  @@index([detectedAt])
}

