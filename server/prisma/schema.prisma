  baseline       Json
  scenario       Json
  result         Json
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model OptimizationProposal {
  id               String           @id @default(uuid())
  userId           String
  type             OptimizationType @default(WORKLOAD)
  targetEntityId   String?
  title            String
  currentState     String
  proposedState    String
  expectedImpact   Json
  confidence       ForecastConfidence @default(MEDIUM)
  reason           String
  evidence         Json
  approvalRequired Boolean          @default(true)
  status           String           @default("PROPOSED")
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
}

model BusinessRecommendation {
  id               String              @id @default(uuid())
  userId           String
  recommendationType RecommendationType @default(OPTIMIZE_WORKLOAD)
  priority         TaskPriority        @default(HIGH)
  title            String
  reason           String
  evidence         Json
  expectedImpact   String
  risk             PredictionRiskLevel @default(LOW)
  confidenceScore  Float               @default(0.85)
  status           String              @default("OPEN")
  actionType       String              @default("OPTIMIZE_WORKLOAD")
  suggestedPayload Json?
  createdAt        DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([priority])
  @@index([status])
}
